# Phase 0: no secrets required. Values are populated after `npx ampx sandbox` (Phase 1+).

# Local mock API (Next.js route handlers under /api). Created by `npm run setup`.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000/api

# Amazon Location Service — map tiles (fastest local path: API key on a map resource)
# Create an API key in Location Service → API keys with Maps actions (geo-maps:*)
# on arn:aws:geo-maps:<region>::provider/default — not Places-only, or tiles 403.
# Or run `npm run sandbox` and omit NEXT_PUBLIC_AMAZON_LOCATION_API_KEY.
NEXT_PUBLIC_AWS_REGION=us-west-2
NEXT_PUBLIC_AMAZON_LOCATION_API_KEY=
NEXT_PUBLIC_LOCATION_MAP_STYLE=Standard
# Server-only (ZIP geocode); can match the public key for local dev
AMAZON_LOCATION_API_KEY=

# Google OAuth (set in Amplify secrets, not here)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
