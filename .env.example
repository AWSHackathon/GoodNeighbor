# After `npm run sandbox`, setup writes the deployed API URL from amplify_outputs.json.
# NEXT_PUBLIC_API_URL=https://xxxx.execute-api.us-east-1.amazonaws.com

# Local Next.js mock routes (/api/leaderboard, /api/location/geocode)
NEXT_PUBLIC_LOCAL_API_URL=http://127.0.0.1:3000/api

# Amazon Location Service — map tiles (fastest local path: API key on a map resource)
NEXT_PUBLIC_AWS_REGION=us-west-2
NEXT_PUBLIC_AMAZON_LOCATION_API_KEY=
NEXT_PUBLIC_LOCATION_MAP_STYLE=Standard
AMAZON_LOCATION_API_KEY=

# Google OAuth — set via Amplify secrets (not in git):
# npx ampx sandbox secret set GOOGLE_CLIENT_ID
# npx ampx sandbox secret set GOOGLE_CLIENT_SECRET
